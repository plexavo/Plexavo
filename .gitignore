# Python
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.pytest_cache/

# Terraform — state files contain plaintext secrets; provider binaries are
# large and regenerated by `terraform init`. Covers both the published
# examples/quickstart-sandbox.tf and any local, unpublished maintainer
# testbed (see docs/TEST-MATRIX.md).
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/*.tfplan
# Do NOT ignore .terraform.lock.hcl — Terraform itself asks you to commit
# this one, it pins provider versions for reproducible applies.

# OS
.DS_Store
Thumbs.db

# Report output — may contain real findings from whatever account you scanned.
# Root-anchored and wildcarded on purpose: --report-html/--report-pdf let you
# name the output anything (report_default.html, report_ai.html, ...), so
# matching exact filenames isn't enough — this catches any .html/.pdf
# generated at the repo root without touching docs/ or the .j2 template.
outputs/
/report*.html
/report*.pdf
